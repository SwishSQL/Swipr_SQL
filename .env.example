# ---------------------------------------------------------------------------
# Swipr + Quality - SQL Server edition. Copy to .env and fill in. NEVER commit .env
# ---------------------------------------------------------------------------

# --- SQL Server connection: use ONE of the two styles -----------------------
# 1) one URL (percent-encode special characters in the password, e.g. @ -> %40)
DATABASE_URL=sqlserver://swipr_app:your-password@sql-host:1433/Swish_Swipr

# 2) or the separate pieces
# MSSQL_HOST=sql-host
# MSSQL_PORT=1433
# MSSQL_USER=swipr_app
# MSSQL_PASSWORD=your-password
# MSSQL_DATABASE=Swish_Swipr
# MSSQL_INSTANCE=            # only for a NAMED instance (then leave MSSQL_PORT out)

# Transport options (apply to both styles; also accepted as ?encrypt=..&trustServerCertificate=.. on DATABASE_URL)
# MSSQL_ENCRYPT=true         # default false. Set true if the server requires encrypted connections
# MSSQL_TRUST_CERT=true      # default true. Accepts a self signed server certificate

# Create the database (needs the dbcreator role) and every table / view at start (default false).
# Leave it off if the DBA runs sql/schema.sql: the app then only checks the schema and refuses to start if something is missing.
# AUTO_INIT_DB=true

# --- Web server --------------------------------------------------------------
# Port the app listens on (all interfaces).
PORT=8080

# REQUIRED. Signs the login tokens. At least 32 random characters. People stay signed in after the move only if this equals the
# old system's value.
JWT_SECRET=

# Timezone used for clock times in notification text and for "which day" decisions (default Asia/Kuwait)
# APP_TIMEZONE=Asia/Kuwait

# --- Quality module ------------------------------------------------------------
# QA_MODULE=off              # switches the Quality module off completely
# Call recordings of the Quality module (its own XonTel account; one session per account, so NOT the same as XONTEL_* below)
# QA_XONTEL_BASE_URL=
# QA_XONTEL_USERNAME=
# QA_XONTEL_PASSWORD=
# QA_XONTEL_TOKEN=
# QA_XONTEL_CF_ACCESS_CLIENT_ID=
# QA_XONTEL_CF_ACCESS_CLIENT_SECRET=
# Evaluation images: Cloudinary (without it images are stored in the database, max 1 MB each)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Swipr integrations (all optional) -----------------------------------------
# XonTel (agent KPIs): base URL + token, or username/password
# XONTEL_BASE_URL=
# XONTEL_USERNAME=
# XONTEL_PASSWORD=
# XONTEL_TOKEN=
# Fingerprint terminal bridge (shared secret of /api/attendance/device-sync)
# ATTENDANCE_BRIDGE_KEY=
# Web push
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:it@example.com
# Native push
# FIREBASE_SERVICE_ACCOUNT_JSON=
# In-app calls: TURN relay
# TURN_URLS=
# TURN_USERNAME=
# TURN_CREDENTIAL=

# --- One-off data migration from the old PostgreSQL (Railway) database --------
# Only used by:  npm run migrate:from-postgres
# PG_SOURCE_URL=postgresql://user:password@host:port/database
# PG_SSL=true               # only if the source requires TLS
